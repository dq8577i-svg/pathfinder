# =============================================================
# 知径 Pathfinder · 环境变量示例
# 复制为 .env.local 使用；真实密钥只写入 .env.local（已被 gitignore 排除）
# 演示默认使用 Mock AI（标注「AI 整理（演示）」），无需任何密钥即可运行。
# =============================================================

# 是否启用真实 DeepSeek（Anthropic 兼容端点）。默认 false。
# false 时始终使用演示 Mock Provider，页面零请求外发。
DEEPSEEK_ENABLED=false

# DeepSeek Anthropic 兼容端点
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# 访问令牌（Bearer）——请勿把真实值提交到仓库；只放 .env.local
DEEPSEEK_API_KEY=

# DeepSeek 模型名（可选，默认 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

# --- 后端（M1+）—— 以下均为占位，复制为 .env.local 后填写真实值 ---

# PostgreSQL —— 独立 pathfinder 库（严禁使用 mydb）
# DATABASE_URL=postgresql://admin:CHANGE_ME@localhost:5432/pathfinder

# Redis
# REDIS_URL=redis://:CHANGE_ME@localhost:6379

# Auth 会话签名密钥 —— 本地开发可随机生成并标注 LOCAL DEVELOPMENT ONLY
# AUTH_SECRET=replace-with-64-hex-chars

# --- 认证（M2）—— 均为占位，复制为 .env.local 后按需填写 ---

# 页面级认证门禁：true 时 middleware 拦截未认证页面。默认 false（保留演示快速进入）。
# AUTH_GATE=false

# Cookie Secure：生产 HTTPS 时设 true；本地 HTTP 保持 false，否则登录态被浏览器拒绝。
# COOKIE_SECURE=false

# 5 个演示账号的本地开发登录口令（LOCAL DEV ONLY，勿提交真实值；seed 读取它设口令）。
# DEMO_PASSWORD=
