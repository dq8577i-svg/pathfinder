# =============================================================
# 知径 Pathfinder DemoZ V2 · 环境变量示例（不含任何真实密钥）
# 本地 API 模式可复制为 .env.local；Docker Compose 可直接读取同名环境变量。
# =============================================================

# 是否启用真实 DeepSeek（Anthropic 兼容端点）。默认 false。
# false 时始终使用演示 Mock Provider，页面零请求外发。
DEEPSEEK_ENABLED=false

# DeepSeek Anthropic 兼容端点
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# 访问令牌（Bearer）——请勿把真实值提交到仓库；只放 .env.local
DEEPSEEK_API_KEY=

# DeepSeek 模型名（可选，默认 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

# 搜索服务；未配置时使用明确标注的 Mock 降级
TAVILY_API_KEY=

# --- 后端（M1+）—— 以下均为占位，复制为 .env.local 后填写真实值 ---

# PostgreSQL —— 独立 pathfinder 库
DATABASE_URL=postgresql://pathfinder:pathfinder_dev_password@localhost:5432/pathfinder

# Redis
# 用于限流、幂等与后续任务队列
REDIS_URL=redis://:pathfinder_redis_dev@localhost:6379

# MinIO / S3-compatible 对象存储
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=pathfinder_minio
MINIO_SECRET_KEY=pathfinder_minio_dev_password
MINIO_BUCKET=pathfinder-assets
MAX_UPLOAD_BYTES=10485760

# Auth 会话签名密钥 —— 本地开发可随机生成并标注 LOCAL DEVELOPMENT ONLY
AUTH_SECRET=replace-with-64-hex-chars

# --- 认证（M2）—— 均为占位，复制为 .env.local 后按需填写 ---

# 页面级认证门禁
AUTH_GATE=true

# 只允许在面试/试点环境启用的一键角色登录；正式环境必须 false
ALLOW_DEMO_LOGIN=true

# Cookie Secure：生产 HTTPS 时设 true；本地 HTTP 保持 false，否则登录态被浏览器拒绝。
COOKIE_SECURE=false

# 5 个演示账号的本地开发登录口令（LOCAL DEV ONLY，勿提交真实值；seed 读取它设口令）。
DEMO_PASSWORD=DemoPass123!

# Compose 服务口令；公开部署前必须替换
POSTGRES_PASSWORD=pathfinder_dev_password
REDIS_PASSWORD=pathfinder_redis_dev
MINIO_ROOT_USER=pathfinder_minio
MINIO_ROOT_PASSWORD=pathfinder_minio_dev_password
